# PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procureflow_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Server Port
SERVER_PORT=8080

# JWT Security Configuration
JWT_SECRET=your_base64_or_hex_secret_key_minimum_32_bytes_here
JWT_EXPIRATION_MS=86400000

# Optional Initial Development Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@procureflow.com
DEFAULT_ADMIN_PASSWORD=replace-with-local-admin-password
